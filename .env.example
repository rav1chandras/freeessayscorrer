# Copy to .env and fill in real values.

# ── Required ──────────────────────────────────────────────────────────────

# OpenAI — powers the essay tools
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Admin dashboard password (leave empty to disable /admin entirely)
# Use something long + random: `openssl rand -base64 24`
ADMIN_PASSWORD=change-me

# MySQL connection — required in production
# On Hostinger: hPanel → Databases → MySQL has all of these
# For local dev via docker-compose, defaults already set in compose file
DB_HOST=localhost
DB_PORT=3306
DB_USER=fes
DB_PASSWORD=fes_dev_password
DB_NAME=freeessayscorer

# ── Local docker-compose only ────────────────────────────────────────────

# Root password for the dev MySQL container (dev use only)
MYSQL_ROOT_PASSWORD=root_dev_password
